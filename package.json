{
  "name": "datatables-alteditor-lite",
  "version": "0.6.1",
  "description": "AltEditorLite is a lightweight native record editor with DataTables and standalone hosts.",
  "author": "Ben Situ",
  "homepage": "https://bensitu.github.io/datatables-alteditor-lite/",
  "bugs": {
    "url": "https://github.com/bensitu/datatables-alteditor-lite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bensitu/datatables-alteditor-lite.git"
  },
  "keywords": [
    "alteditorlite",
    "datatables",
    "data-table",
    "record-editor",
    "crud",
    "inline-editing",
    "batch-editing",
    "form-validation",
    "standalone",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "sideEffects": [
    "./dist/umd/alt-editor-lite.css",
    "./dist/esm/datatables.js"
  ],
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "unpkg": "./dist/umd/alt-editor-lite.min.js",
  "jsdelivr": "./dist/umd/alt-editor-lite.min.js",
  "style": "./dist/umd/alt-editor-lite.css",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./datatables": {
      "types": "./dist/esm/datatables.d.ts",
      "import": "./dist/esm/datatables.js"
    },
    "./standalone": {
      "types": "./dist/esm/standalone.d.ts",
      "import": "./dist/esm/standalone.js"
    },
    "./style.css": "./dist/umd/alt-editor-lite.css",
    "./locales/*.json": "./dist/esm/locales/*.json",
    "./locales/*": {
      "types": "./dist/esm/locales/*.d.ts",
      "import": "./dist/esm/locales/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "husky",
    "prepack": "npm run build",
    "clean": "node scripts/clean-dist.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.css\" \"examples/**/*.css\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:types": "tsd",
    "verify:package": "node scripts/verify-package-boundaries.mjs",
    "build:js": "rolldown -c",
    "build:css": "node scripts/build-css.mjs",
    "build:locales": "node scripts/build-locales.mjs",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "npm run clean && npm run typecheck && npm run build:js && npm run build:css && npm run build:locales && npm run build:types",
    "check": "npm run format:check && npm run lint && npm run lint:styles && npm run test:coverage && npm run build && npm run verify:package && npm run test:types && npm run test:e2e"
  },
  "peerDependencies": {
    "datatables.net": ">=3.0.0 <4",
    "datatables.net-buttons": ">=4.0.0 <5",
    "datatables.net-select": ">=4.0.0 <5"
  },
  "peerDependenciesMeta": {
    "datatables.net": {
      "optional": true
    },
    "datatables.net-buttons": {
      "optional": true
    },
    "datatables.net-select": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "20.4.4",
    "@commitlint/config-conventional": "20.4.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/jquery": "4.0.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.11",
    "datatables.net": "^3.0.2",
    "datatables.net-autofill": "^3.0.0",
    "datatables.net-buttons": "^4.0.2",
    "datatables.net-colreorder": "^3.0.1",
    "datatables.net-columncontrol": "^2.0.1",
    "datatables.net-fixedheader": "5.0.0",
    "datatables.net-keytable": "^3.0.0",
    "datatables.net-responsive": "^4.0.2",
    "datatables.net-rowreorder": "^2.0.0",
    "datatables.net-scroller": "3.0.0",
    "datatables.net-searchbuilder": "^2.0.0",
    "datatables.net-select": "^4.0.1",
    "eslint": "10.9.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-tsdoc": "0.5.2",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "lightningcss": "1.33.0",
    "lint-staged": "16.2.7",
    "prettier": "3.9.6",
    "rolldown": "1.2.5",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tsd": "0.33.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix --max-warnings 0"
    ]
  },
  "tsd": {
    "directory": "tests/types"
  }
}
