{
  "name": "datatables-alteditor-lite",
  "version": "0.1.0",
  "description": "A lightweight native editing extension for DataTables 3.x.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "sideEffects": [
    "./dist/alt-editor-lite.css",
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/datatables-alteditor-lite.min.js",
  "jsdelivr": "./dist/datatables-alteditor-lite.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/alt-editor-lite.css",
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "import": "./dist/locales/en.js"
    },
    "./locales/ja": {
      "types": "./dist/locales/ja.d.ts",
      "import": "./dist/locales/ja.js"
    },
    "./locales/zh-cn": {
      "types": "./dist/locales/zh-cn.d.ts",
      "import": "./dist/locales/zh-cn.js"
    },
    "./locales/es": {
      "types": "./dist/locales/es.d.ts",
      "import": "./dist/locales/es.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "husky",
    "clean": "node scripts/clean-dist.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.css\" \"examples/**/*.css\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:coverage && npm run test:critical",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:critical": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:types": "tsd",
    "build:js": "rolldown -c",
    "build:css": "node scripts/build-css.mjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "npm run clean && npm run typecheck && npm run build:js && npm run build:css && npm run build:types",
    "ci:core": "npm run format:check && npm run lint && npm run lint:styles && npm run typecheck && npm run test && npm run build && npm run test:types && npm run test:e2e"
  },
  "peerDependencies": {
    "datatables.net": ">=3.0.0 <4",
    "datatables.net-buttons": ">=4.0.0 <5",
    "datatables.net-select": ">=4.0.0 <5"
  },
  "peerDependenciesMeta": {
    "datatables.net-buttons": {
      "optional": true
    },
    "datatables.net-select": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@commitlint/cli": "20.4.4",
    "@commitlint/config-conventional": "20.4.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/jquery": "4.0.1",
    "@types/node": "25.4.0",
    "@vitest/coverage-v8": "4.1.10",
    "datatables.net": "3.0.1",
    "datatables.net-buttons": "4.0.1",
    "datatables.net-select": "4.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-tsdoc": "0.5.2",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "lightningcss": "1.33.0",
    "lint-staged": "16.2.7",
    "prettier": "3.9.6",
    "rolldown": "1.2.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tsd": "0.33.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix --max-warnings 0"
    ]
  },
  "tsd": {
    "directory": "tests/types"
  }
}
